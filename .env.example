API_INTERNAL_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/orbit.db
OPENROUTER_API_KEY=
BROWSERBASE_API_KEY=
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
ALLOW_DEMO=true
# Jev triage (fast decision model): shadow = log only (default), active = act on confident skips, off
JEV_MODE=shadow

# Most a single agent run may spend on models (USD) before it stops. Default 1.00.
RUN_BUDGET_USD=1.0

# City/address autocomplete for the profile form (locationiq.com; free, no card). Optional: without it the
# location fields fall back to the static suggestion list, never blocking onboarding.
LOCATIONIQ_API_KEY=

# Residential proxies for LinkedIn/Indeed sessions (avoids bot blocks); BROWSERBASE_PROXIES=false turns them off.
BROWSERBASE_PROXY_COUNTRY=IN
